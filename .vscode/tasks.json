{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jalankan SMART SEROK Bot",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["bot.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": false,
      "problemMatcher": [],
      "group": {"kind": "build", "isDefault": true},
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Tes konfigurasi SMART SEROK",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["bot.py", "--check-config"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
