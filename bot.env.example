# gmgn_trading_bot v0.2.0 — SECRET LOKAL
# Salin menjadi bot.env. Bot memuatnya otomatis di semua OS.
# bot.env tidak masuk Git dan tidak masuk ZIP update.

# API key resmi: https://gmgn.ai/ai
GMGN_API_KEY=isi_api_key_gmgn

# Wajib untuk empat sinyal SMART SEROK. Ambil nilai header Cookie dari request
# token_trades di DevTools browser GMGN. Simpan di komputer sendiri, jangan chat.
GMGN_WEB_COOKIE=isi_seluruh_cookie_header_gmgn

# Telegram control
TELEGRAM_BOT_TOKEN=isi_token_botfather
TELEGRAM_CHAT_ID=isi_chat_id_pemilik

# Tidak ada private key wallet. Auto-trade selalu OFF.
