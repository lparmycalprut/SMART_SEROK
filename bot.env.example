# gmgn_trading_bot — template environment variable
# Salin menjadi file secret di luar Git, misalnya:
#   cp bot.env.example bot.env
#   chmod 600 bot.env
#
# Bot otomatis memuat bot.env pada Windows, Linux, dan macOS.
# Environment variable yang sudah aktif di proses akan menang atas isi file.
# Jangan commit, upload, screenshot, atau kirim isi file secret.

# Wajib — buat API key di https://gmgn.ai/ai
GMGN_API_KEY=isi_api_key_gmgn_di_sini

# Opsional — keduanya harus diisi jika alert Telegram digunakan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto-trade belum tersedia dan selalu OFF pada v0.1.5.
