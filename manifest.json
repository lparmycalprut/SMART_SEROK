{
  "manifest_version": 3,
  "name": "SMART SEROK",
  "version": "9.3.0",
  "description": "SMART SEROK v9.3.0 — GMGN Agent API (key tertanam + autosave lokal), feed smart-money/KOL, dan deteksi AKUMULASI/DISTRIBUSI dari CVD: absorpsi di support/resistance, divergensi CVD vs harga, dan akumulasi/distribusi bertahap saat harga flat.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://openapi.gmgn.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
